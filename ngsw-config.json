{
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/*.png"
        ]
      }
    },
    {
      "name": "imagenes",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/images/*.webp"
        ]
      }
    },
    {
      "name": "ayuda",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/ayuda-web/**"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api",
    "!/api/**"
  ]
}
